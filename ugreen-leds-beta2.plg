  "config_sha256": "b3462a4a0d1c7566f447230c970b068b7b4b759ff1f29a5f972216d14a661160",
  "packages": [
    {"name": "unraid-7.4.0-beta.2-r1--i2c-tools-4.3-x86_64-1candidate.txz", "sha256": "78fe26d369a6758e6bcf94174a0bb13ed3a3f134fb2aad0b67fcceeb8907a7a1", "size": 79416},
    {"name": "unraid-7.4.0-beta.2-r1--ugreen_leds-992fc6d_7.4.0_beta.2_6.18.47_Unraid-x86_64-1candidate.txz", "sha256": "9ed5f59342a02654f43692620acdf339725f322388d4df345a24f6b585657b58", "size": 10264},
    {"name": "unraid-7.4.0-beta.2-r1--ugreenleds-driver-7.4.0_beta.2_r1-noarch-1candidate.txz", "sha256": "d2d8d75a6af785600e99732ec3664f2ae6afa13f3a84908c246d0135deedd187", "size": 3596}
  ]
}
</INLINE><SHA256>69b62b817628268ad96593fcc48e81c4731d23681d764d1dea773a5ab4edf812</SHA256></FILE>
<FILE Name="/usr/local/emhttp/plugins/ugreen-leds-beta2/verify-installed-payload.sh" Mode="0644"><INLINE>#!/bin/bash
# Compare installed payload bytes with an already approved archive. The caller
# owns the private staging directory and deletes it after verification.
set -euo pipefail
[[ $# == 3 ]] || exit 1
archive=$1
runtime=$2
stage=$3
[[ -f $archive &amp;&amp; -d $runtime &amp;&amp; -d $stage &amp;&amp; ! -L $stage ]] || exit 1
payload=$(mktemp -d "$stage/payload.XXXXXXXX")
tar -xf "$archive" -C "$payload"
find "$payload" \( -type f -o -type l \) -print0 &gt; "$payload.members"
count=0
while IFS= read -r -d '' member; do
  relative=${member#"$payload"/}
  # Package-manager metadata is recorded in pkgtools, not installed at /install.
  case $relative in install/*) continue ;; esac
  installed="$runtime/$relative"
  if [[ -L $member ]]; then
    [[ -L $installed &amp;&amp; $(readlink -- "$member") == "$(readlink -- "$installed")" ]] || {
      echo "Installed symlink mismatch: $relative" &gt;&amp;2; exit 1;
    }
  else
    if [[ ! -f $installed || -L $installed ]] || ! cmp -s -- "$member" "$installed"; then
      echo "Installed payload mismatch: $relative" &gt;&amp;2; exit 1
    fi
  fi
  count=$((count + 1))
done &lt; "$payload.members"
[[ $count -gt 0 ]] || { echo 'Package has no verifiable payload' &gt;&amp;2; exit 1; }
</INLINE><SHA256>fc11692487986449341420a6165a75bfdbba76b2436484f99f0178315abd32e8</SHA256></FILE>
<FILE Name="/usr/local/emhttp/plugins/ugreen-leds-beta2/settings.cfg.example" Mode="0644"><INLINE>MAPPING_METHOD="ata"
DISK_SERIAL="SN1 SN2 SN3 SN4"
COLOR_DISK_HEALTH="255 255 255"
BRIGHTNESS_DISK_LEDS="255"
COLOR_DISK_UNAVAIL="255 0 0"
LED_REFRESH_INTERVAL="0.5"
CHECK_DISK_ONLINE_INTERVAL="5"
CHECK_GATEWAY_CONNECTIVITY="true"
COLOR_NETDEV_NORMAL="255 165 0"
COLOR_NETDEV_LINK_100="0 255 0"
COLOR_NETDEV_LINK_1000="0 0 255"
COLOR_NETDEV_LINK_2500="255 255 0"
COLOR_NETDEV_LINK_10000="255 255 255"
COLOR_NETDEV_GATEWAY_UNREACHABLE="255 0 0"
CHECK_NETDEV_INTERVAL="30"
</INLINE><SHA256>c15346e2f4dfb423a07863e9be6ed49f8730956aaa23e4bbd22ff0c26263eb5a</SHA256></FILE>
<FILE Run="/bin/bash"><INLINE>bash /usr/local/emhttp/plugins/ugreen-leds-beta2/beta2-test.sh check
</INLINE></FILE>
