<FILE Name="/boot/config/plugins/ugreen-leds-beta2/packages/6.18.47-Unraid/ugreenleds-driver-7.4.0_beta.2_r1-noarch-1candidate.txz"><URL>https://github.com/unraid/unraid-ugreenleds-driver/releases/download/6.18.47-Unraid/unraid-7.4.0-beta.2-r1--ugreenleds-driver-7.4.0_beta.2_r1-noarch-1candidate.txz</URL><SHA256>d2d8d75a6af785600e99732ec3664f2ae6afa13f3a84908c246d0135deedd187</SHA256></FILE>
<FILE Run="/bin/bash"><INLINE>bash /usr/local/emhttp/plugins/ugreen-leds-beta2/beta2-test.sh install
</INLINE></FILE>
<FILE Run="/bin/bash" Method="remove"><INLINE>echo "Test boot startup removed. Reboot to stop the loaded module and monitor."
